# AlojaExpress — Variables de Entorno de Producción
# Renombrar este archivo a .env antes de iniciar la configuración

# ── POSTGRESQL (SUPABASE / PRODUCCIÓN) ─────────────────────────────
# Reemplazar con las URLs de conexión reales provistas por Supabase
# Cada microservicio utiliza su propia base de datos dedicada.
ConnectionStrings__ConexionUsuarios="Host=db.supabase.co;Port=5432;Database=db_usuarios;Username=postgres;Password=TU_CONTRASEÑA_SUPABASE;"
ConnectionStrings__ConexionAlojamientos="Host=db.supabase.co;Port=5432;Database=db_alojamientos;Username=postgres;Password=TU_CONTRASEÑA_SUPABASE;"
ConnectionStrings__ConexionReservas="Host=db.supabase.co;Port=5432;Database=db_reservas;Username=postgres;Password=TU_CONTRASEÑA_SUPABASE;"
ConnectionStrings__ConexionFacturacion="Host=db.supabase.co;Port=5432;Database=db_facturacion;Username=postgres;Password=TU_CONTRASEÑA_SUPABASE;"

# ── RABBITMQ ──────────────────────────────────────────────────────
# Credenciales para el bus de eventos en producción (ej. CloudAMQP o local)
ConnectionStrings__RabbitMQ="amqp://alojaexpress:AlojaRabbit2024!@rabbitmq-host:5672/"

# ── JWT SEGURIDAD (FASE 10) ───────────────────────────────────────
# Clave secreta para firmar los tokens JWT (debe ser mayor a 32 caracteres)
Jwt__Secret="SuperSecretKeyAlojamiento2026!SecureKeyForProdEnvironment#"

# ── GESTIÓN DE IMÁGENES (CLOUDINARY - FASE 7) ─────────────────────
# Configuración para subir imágenes de alojamientos a Cloudinary
Cloudinary__CloudName="tu_cloud_name"
Cloudinary__ApiKey="tu_api_key"
Cloudinary__ApiSecret="tu_api_secret"

# ── BOOKING.COM INTEGRACIÓN ───────────────────────────────────────
# Credenciales para webhooks de Booking.com y sincronización bidireccional
BookingIntegration__ApiKey="alojaexpress_booking_secret_key_12345"
BookingIntegration__HmacSecret="alojaexpress_booking_hmac_secret_67890"
BookingIntegration__BookingApiUrl="https://api.booking.com"

# ── URLS INTERNAS DEL GATEWAY (MICROSERVICES HOSTS) ───────────────
# URLs que usará el Gateway para redirigir tráfico mediante YARP/gRPC
Microservices__UsuariosUrl="http://usuarios-api:8080"
Microservices__AlojamientosUrl="http://alojamientos-api:8080"
Microservices__ReservasUrl="http://reservas-api:8080"
Microservices__FacturacionUrl="http://facturacion-api:8080"

# ── FRONTEND ──────────────────────────────────────────────────────
# URL base que el frontend usará para llamar al API Gateway
VITE_API_BASE_URL=/api/v1

# ── CONFIGURACIÓN CORS (FASE 10) ──────────────────────────────────
# Lista de orígenes permitidos en producción (se mapean como array en ASP.NET Core)
Cors__AllowedOrigins__0="https://tu-frontend-desplegado.vercel.app"
Cors__AllowedOrigins__1="http://localhost:5173"


