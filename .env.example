# AlojaExpress — Variables de Entorno de Producción
# Renombrar este archivo a .env antes de ejecutar docker-compose

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=AlojaExpress2024!Secure

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_USER=alojaexpress
RABBITMQ_PASS=AlojaRabbit2024!

# ── Booking.com Webhooks ──────────────────────────────────────────
# Reemplazar con credenciales reales de Booking.com Connectivity Partner
BOOKING_API_KEY=alojaexpress_booking_secret_key_12345
BOOKING_HMAC_SECRET=alojaexpress_booking_hmac_secret_67890

# ── Frontend (URL pública del API Gateway) ────────────────────────
VITE_API_BASE_URL=/api/v1
