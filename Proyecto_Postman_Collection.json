    {
      "name": "Reservas",
      "item": [
        {
          "name": "Crear Reserva (Orquestador + Calendario)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.datos && jsonData.datos.codigoReserva) {",
                  "    pm.collectionVariables.set(\"codigoReserva\", jsonData.datos.codigoReserva);",
                  "    pm.collectionVariables.set(\"reservaId\", jsonData.datos.reservaId);",
                  "    console.log(\"Reserva guardada:\", jsonData.datos.codigoReserva);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"alojamientoId\": 1,\n  \"fechaCheckIn\": \"2026-07-01\",\n  \"fechaCheckOut\": \"2026-07-05\",\n  \"numAdultos\": 2,\n  \"numNinos\": 0,\n  \"llevaMascotas\": false,\n  \"codigoDescuento\": null,\n  \"habitaciones\": [\n    {\n      \"habitacionId\": 1,\n      \"precioPorNoche\": 150.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/reservas-alojaexpress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "reservas-alojaexpress"
              ]
            }
          },
          "response": []
