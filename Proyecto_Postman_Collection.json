  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar Sesión (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.datos && jsonData.datos.token) {",
                  "    pm.collectionVariables.set(\"alojaexpress_token\", jsonData.datos.token);",
                  "    pm.collectionVariables.set(\"clienteId\", jsonData.datos.clienteId || 1);",
                  "    pm.collectionVariables.set(\"colaboradorId\", jsonData.datos.colaboradorId || 1);",
                  "    console.log(\"Token guardado exitosamente:\", jsonData.datos.token);",
                  "} else if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"alojaexpress_token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"clienteId\", jsonData.clienteId || 1);",
                  "    console.log(\"Token guardado exitosamente (root):\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@booking.com\",\n  \"password\": \"Admin2025!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/auth-alojaexpress/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "auth-alojaexpress",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
